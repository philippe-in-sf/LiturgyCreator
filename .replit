modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Liturgical Calendar GUI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Calendar"

[[workflows.workflow]]
name = "Liturgical Calendar GUI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python liturgical_calendar.py"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow]]
name = "Web Calendar"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_calendar.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "cloudrun"
run = ["python3", "app.py"]
