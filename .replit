modules = ["python-3.11", "python3"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libGL", "libGLU", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "swig", "tcl", "tesseract", "tk", "xcbuild", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Liturgical Calendar GUI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Calendar"

[[workflows.workflow]]
name = "Liturgical Calendar GUI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python liturgical_calendar.py"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow]]
name = "Web Calendar"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 8002
externalPort = 3001

[[ports]]
localPort = 39621
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "web_calendar:app"]
build = ["uv", "sync"]
